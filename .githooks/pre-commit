#!/bin/sh
# ABOUTME: Rejects commits that fail Rust formatting or strict Clippy checks.
# ABOUTME: Keeps the full workspace, examples, tests, and benches warning-clean.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "Checking Rust formatting..."
cargo fmt --all -- --check

echo "Running strict Clippy checks..."
cargo clippy --all-targets --all-features -- -D warnings
